{
  "name": "meteor-react-base-mui",
  "private": true,
  "scripts": {
    "precommit": "pretty-quick --staged",
    "start": "meteor run",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:prod": "docker compose -f docker-compose.yml up --build",
    "docker:prod:detached": "docker compose -f docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker-compose.yml down && docker compose -f docker-compose.dev.yml down",
    "docker:down:volumes": "docker compose -f docker-compose.yml down -v && docker compose -f docker-compose.dev.yml down -v",
    "docker:logs:dev": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:logs:prod": "docker compose -f docker-compose.yml logs -f",
    "test": "meteor test --once --driver-package meteortesting:mocha",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:all": "tsc --noEmit --pretty false",
    "test-app": "TEST_WATCH=1 meteor test --full-app --driver-package meteortesting:mocha",
    "visualize": "meteor --production --extra-packages bundle-visualizer",
    "cypress:gui": "cypress open",
    "cypress:headless": "cypress run",
    "doctor": "node tools/cli.mjs doctor",
    "module:new": "node tools/cli.mjs module:new",
    "agent:context": "node tools/cli.mjs agent:context",
    "task:validate": "node tools/cli.mjs task:validate",
    "task:state": "node tools/cli.mjs task:state",
    "patch:check": "node tools/cli.mjs patch:check",
    "boundaries:check": "node tools/cli.mjs boundaries:check",
    "docs:verify": "node tools/cli.mjs docs:verify",
    "templates:verify": "node tools/cli.mjs templates:verify",
    "check:changed": "node tools/cli.mjs check:changed",
    "test:toolkit": "node --test tools/test/*.test.mjs evals/*.test.mjs",
    "test:security": "TEST_SERVER_ONLY=1 meteor test --once --driver-package meteortesting:mocha --port 3102",
    "verify": "npm run typecheck && npm run test:core && npm run test:toolkit && npm run boundaries:check && npm run templates:verify && npm run docs:verify && npm run test:security",
    "verify:release": "npm run verify && npm run templates:runtime && npm run test:browser && meteor build /tmp/meteor-release-build --directory",
    "test:core": "node tools/run-core-tests.mjs",
    "eval:agents": "node evals/report.mjs",
    "templates:runtime": "node tools/verify-template-runtime.mjs",
    "test:browser": "cypress run --config-file cypress.ai-ready.config.ts"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@date-io/date-fns": "^3.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-data-grid": "^8.28.6",
    "awesome-notifications": "^3.1.3",
    "body-parser": "^2.2.2",
    "connect-route": "^0.1.5",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.12",
    "idb-keyval": "^6.2.2",
    "konva": "^10.3.0",
    "later": "^1.2.0",
    "lodash": "^4.18.1",
    "meteor-node-stubs": "^1.2.27",
    "nanoid": "^5.1.11",
    "prop-types": "^15.8.1",
    "react": "^19.2.6",
    "react-avatar-editor": "^15.1.0",
    "react-dom": "^19.2.6",
    "react-dropzone": "^15.0.0",
    "react-file-input-previews-base64": "^1.0.8",
    "react-number-format": "^5.4.5",
    "react-sortablejs": "^6.1.4",
    "react-transition-group": "^4.4.5",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "unidecode": "^1.1.0",
    "zipson": "^0.2.12",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/meteor": "^2.9.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sortablejs": "^1.15.9",
    "cypress": "^15.15.0",
    "esbuild": "^0.28.1",
    "less": "^4.6.4",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "meteor": {
    "testModule": {
      "client": "tests/main.ts",
      "server": "tests/server.ts"
    }
  },
  "overrides": {
    "qs": "6.16.1",
    "meteor-node-stubs": {
      "url": {
        "qs": "6.16.1"
      }
    },
    "pbkdf2": "3.1.7",
    "serialize-javascript": "7.1.2",
    "diff": "8.0.3"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <13"
  }
}
