{
	"schemaVersion": 1,
	"name": "purchases",
	"profile": "owner",
	"fields": [
		{ "name": "description", "label": "Description", "type": "string", "required": true, "maxLength": 200 },
		{ "name": "start", "label": "Start", "type": "date", "required": true },
		{ "name": "end", "label": "End", "type": "date", "required": true },
		{
			"name": "amount",
			"label": "Amount",
			"type": "money",
			"required": true,
			"currency": "BRL",
			"scale": 2,
			"min": 0,
			"max": 100000000
		},
		{ "name": "supplier", "label": "Supplier", "type": "reference", "required": true, "target": "suppliers" }
	],
	"rules": [{ "kind": "lte", "left": "start", "right": "end" }],
	"filters": ["start", "amount", "supplier"],
	"states": ["draft"],
	"transitions": [],
	"permissions": { "read": ["owner"], "write": ["owner"] }
}
