{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "objective",
    "acceptance",
    "allowedPaths",
    "contextFiles",
    "commands",
    "budget",
    "state"
  ],
  "properties": {
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contextFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "planned",
        "running",
        "needs-review",
        "passed",
        "failed"
      ]
    },
    "budget": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "tokens",
        "files",
        "attempts",
        "contextBytes",
        "contextFiles",
        "costUSD"
      ],
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "tokens": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "contextBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "contextFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "costUSD": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}