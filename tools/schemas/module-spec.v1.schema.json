{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateVersion",
    "profile",
    "name"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "templateVersion": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "owner-crud"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,31}$",
      "not": {
        "enum": [
          "tasks",
          "core",
          "index",
          "server",
          "client",
          "test",
          "tests",
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    }
  }
}