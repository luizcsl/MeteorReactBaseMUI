{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "label"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,31}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "identity": {
      "enum": [
        "owner-active-account",
        "reviewed-ports"
      ]
    },
    "ports": {
      "type": "string",
      "pattern": "^imports/.+/server/ports\\.ts$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity": {
            "const": "reviewed-ports"
          }
        },
        "required": [
          "identity"
        ]
      },
      "then": {
        "required": [
          "ports"
        ]
      },
      "else": {
        "not": {
          "required": [
            "ports"
          ]
        }
      }
    }
  ]
}
