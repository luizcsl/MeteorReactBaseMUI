{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Automation result v1",
	"type": "object",
	"required": ["schemaVersion"],
	"properties": {
		"schemaVersion": {
			"const": 1
		},
		"status": {
			"enum": [
				"applied",
				"unchanged",
				"blocked",
				"failed",
				"passed",
				"partial",
				"recovered",
				"needs-review",
				"needs-design",
				"unsupported"
			]
		},
		"qualified": {
			"const": false
		}
	}
}
