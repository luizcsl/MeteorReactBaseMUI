{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "dependencies.v1.schema.json",
	"title": "Separate reviewed dependency update request v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["updates"],
	"properties": {
		"updates": {
			"type": "array",
			"minItems": 1,
			"maxItems": 30,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "from", "to"],
				"properties": {
					"name": { "type": "string", "pattern": "^(?:@[a-z0-9-]+/)?[a-z0-9][a-z0-9._-]*$" },
					"from": {
						"type": "string",
						"minLength": 1,
						"maxLength": 160,
						"description": "Exact current manifest declaration, including any range prefix"
					},
					"to": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-zA-Z0-9.-]+)?$" }
				}
			}
		}
	}
}
