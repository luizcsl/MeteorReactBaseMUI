{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "workflow.v1.schema.json",
	"title": "Bounded recipe workflow guards",
	"type": "object",
	"additionalProperties": false,
	"required": ["transitions"],
	"properties": {
		"transitions": {
			"type": "array",
			"minItems": 1,
			"maxItems": 40,
			"uniqueItems": true,
			"items": { "$ref": "#/$defs/transition" }
		}
	},
	"$defs": {
		"state": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
		"condition": {
			"type": "object",
			"additionalProperties": false,
			"required": ["field", "op", "value"],
			"properties": {
				"field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
				"op": { "enum": ["eq", "ne", "lt", "lte", "gt", "gte"] },
				"value": {
					"type": ["string", "integer", "boolean", "null"],
					"maxLength": 2000,
					"minimum": -9007199254740991,
					"maximum": 9007199254740991
				}
			}
		},
		"deadline": {
			"type": "object",
			"additionalProperties": false,
			"required": ["anchor", "afterMs", "mode"],
			"properties": {
				"anchor": { "const": "updatedAt" },
				"afterMs": { "type": "integer", "minimum": 1, "maximum": 31536000000 },
				"mode": { "enum": ["before", "after"] }
			}
		},
		"transition": {
			"type": "object",
			"additionalProperties": false,
			"required": ["from", "to"],
			"anyOf": [{ "required": ["conditions"] }, { "required": ["deadline"] }],
			"properties": {
				"from": { "$ref": "#/$defs/state" },
				"to": { "$ref": "#/$defs/state" },
				"conditions": {
					"type": "array",
					"minItems": 1,
					"maxItems": 20,
					"uniqueItems": true,
					"items": { "$ref": "#/$defs/condition" }
				},
				"deadline": { "$ref": "#/$defs/deadline" }
			}
		}
	}
}
