{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "services.v1.schema.json",
	"title": "Bounded automation services v1",
	"description": "Discoverable structural contract. validateServices(services, definition) is mandatory for recipe-aware semantic constraints. Unknown variants are unsupported, not inferred.",
	"x-runtime-validator": "tools/automation/generators/services.mjs#validateServices",
	"x-semantic-constraints": [
		"Recipe profile cannot be master-detail.",
		"CSV/search field names must exist in the recipe; CSV includes every required recipe field; search fields must be declared recipe filters.",
		"Notification template placeholders must reference recipe fields.",
		"Report metric names must be unique; sum fields must be integer or money.",
		"Dependency names must be unique; from and to must differ; when root is supplied from must exactly match the existing package declaration.",
		"OpenAPI operationId must be globally unique across paths/methods; schema.required must be a subset of schema.properties.",
		"OpenAPI accepts bounded inline schemas only, maximum child depth 6; no refs, security definitions, parameters, polymorphism or arbitrary verbs.",
		"Plain data descriptors are required by runtime validation; accessors, sparse arrays and exotic prototypes are not JSON inputs."
	],
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"attachments": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"maxBytes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 20000000
				},
				"mimeTypes": {
					"type": "array",
					"minItems": 1,
					"maxItems": 10,
					"uniqueItems": true,
					"items": {
						"enum": ["application/pdf", "image/png", "image/jpeg", "text/plain", "text/csv", "application/octet-stream"]
					}
				}
			},
			"required": ["maxBytes", "mimeTypes"]
		},
		"csv": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"fields": {
					"type": "array",
					"minItems": 1,
					"maxItems": 30,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 160,
						"pattern": "^[^\\u0000]+$"
					}
				},
				"maxRows": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10000
				}
			},
			"required": ["fields", "maxRows"]
		},
		"notifications": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"events": {
					"type": "array",
					"minItems": 1,
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 40,
						"pattern": "^[a-z][A-Za-z0-9]*$",
						"not": {
							"enum": ["constructor", "prototype", "__proto__"]
						}
					}
				},
				"subjectTemplate": {
					"type": "string",
					"minLength": 1,
					"maxLength": 200,
					"pattern": "^(?:[^{}\\u0000]|\\{\\{[A-Za-z][A-Za-z0-9]*\\}\\})+$"
				},
				"textTemplate": {
					"type": "string",
					"minLength": 1,
					"maxLength": 10000,
					"pattern": "^(?:[^{}\\u0000]|\\{\\{[A-Za-z][A-Za-z0-9]*\\}\\})+$"
				}
			},
			"required": ["events", "subjectTemplate", "textTemplate"]
		},
		"jobs": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"maxAttempts": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10
				},
				"leaseMs": {
					"type": "integer",
					"minimum": 1000,
					"maximum": 3600000
				}
			},
			"required": ["maxAttempts", "leaseMs"]
		},
		"search": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"fields": {
					"type": "array",
					"minItems": 1,
					"maxItems": 30,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 160,
						"pattern": "^[^\\u0000]+$"
					}
				},
				"pageSize": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100
				}
			},
			"required": ["fields", "pageSize"]
		},
		"audit": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"events": {
					"type": "array",
					"minItems": 1,
					"maxItems": 30,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 40,
						"pattern": "^[a-z][A-Za-z0-9]*$",
						"not": {
							"enum": ["constructor", "prototype", "__proto__"]
						}
					}
				},
				"retentionDays": {
					"type": "integer",
					"minimum": 1,
					"maximum": 3650
				}
			},
			"required": ["events", "retentionDays"]
		},
		"reports": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"metrics": {
					"type": "array",
					"minItems": 1,
					"maxItems": 20,
					"items": {
						"oneOf": [
							{
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"name": {
										"type": "string",
										"minLength": 1,
										"maxLength": 40,
										"pattern": "^[a-z][A-Za-z0-9]*$",
										"not": {
											"enum": ["constructor", "prototype", "__proto__"]
										}
									},
									"op": {
										"const": "count"
									}
								},
								"required": ["name", "op"]
							},
							{
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"name": {
										"type": "string",
										"minLength": 1,
										"maxLength": 40,
										"pattern": "^[a-z][A-Za-z0-9]*$",
										"not": {
											"enum": ["constructor", "prototype", "__proto__"]
										}
									},
									"op": {
										"const": "sum"
									},
									"field": {
										"type": "string",
										"minLength": 1,
										"maxLength": 160,
										"pattern": "^[^\\u0000]+$"
									}
								},
								"required": ["name", "op", "field"]
							}
						]
					}
				}
			},
			"required": ["metrics"]
		},
		"dependencies": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"updates": {
					"type": "array",
					"minItems": 1,
					"maxItems": 30,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"name": {
								"type": "string",
								"pattern": "^(@[a-z0-9-]+/)?[a-z0-9][a-z0-9._-]*$"
							},
							"from": {
								"type": "string",
								"minLength": 1,
								"maxLength": 160,
								"pattern": "^(?=.*[0-9*xX])[0-9A-Za-z*~^<>=|.+ -]+$"
							},
							"to": {
								"$ref": "#/$defs/exactVersion"
							}
						},
						"required": ["name", "from", "to"]
					}
				}
			},
			"required": ["updates"]
		},
		"api": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"openapi": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"openapi": {
							"type": "string",
							"pattern": "^3\\.0\\.\\d+$"
						},
						"info": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"title": {
									"type": "string",
									"minLength": 1,
									"maxLength": 160,
									"pattern": "^[^\\u0000]+$"
								},
								"version": {
									"type": "string",
									"minLength": 1,
									"maxLength": 160,
									"pattern": "^[^\\u0000]+$"
								}
							},
							"required": ["title", "version"]
						},
						"servers": {
							"type": "array",
							"minItems": 1,
							"maxItems": 1,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"url": {
										"type": "string",
										"format": "uri",
										"pattern": "^https://(?!(?:localhost|[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)(?::[0-9]+)?(?:/|$))[^/@:?#\\s]+(?::[0-9]+)?(?:/[^?#\\s]*)?$",
										"description": "URL normalization and hostname checks are additionally enforced by validateServices. Transport must enforce DNS/SSRF egress policy."
									}
								},
								"required": ["url"]
							}
						},
						"paths": {
							"type": "object",
							"minProperties": 1,
							"maxProperties": 20,
							"propertyNames": {
								"type": "string",
								"pattern": "^(?!.*//)/[A-Za-z0-9_/-]*$"
							},
							"additionalProperties": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"get": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"operationId": {
												"type": "string",
												"minLength": 1,
												"maxLength": 40,
												"pattern": "^[a-z][A-Za-z0-9]*$",
												"not": {
													"enum": ["constructor", "prototype", "__proto__"]
												}
											},
											"responses": {
												"type": "object",
												"minProperties": 1,
												"maxProperties": 1,
												"propertyNames": {
													"pattern": "^2\\d\\d$"
												},
												"additionalProperties": {
													"type": "object",
													"additionalProperties": false,
													"properties": {
														"description": {
															"type": "string",
															"minLength": 1,
															"maxLength": 1000,
															"pattern": "^[^\\u0000]+$"
														},
														"content": {
															"type": "object",
															"additionalProperties": false,
															"properties": {
																"application/json": {
																	"type": "object",
																	"additionalProperties": false,
																	"properties": {
																		"schema": {
																			"$ref": "#/$defs/apiSchema0"
																		}
																	},
																	"required": ["schema"]
																}
															},
															"required": ["application/json"]
														}
													},
													"required": ["description", "content"]
												}
											}
										},
										"required": ["operationId", "responses"]
									},
									"post": {
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"operationId": {
												"type": "string",
												"minLength": 1,
												"maxLength": 40,
												"pattern": "^[a-z][A-Za-z0-9]*$",
												"not": {
													"enum": ["constructor", "prototype", "__proto__"]
												}
											},
											"requestBody": {
												"type": "object",
												"additionalProperties": false,
												"properties": {
													"required": {
														"const": true
													},
													"content": {
														"type": "object",
														"additionalProperties": false,
														"properties": {
															"application/json": {
																"type": "object",
																"additionalProperties": false,
																"properties": {
																	"schema": {
																		"$ref": "#/$defs/apiSchema0"
																	}
																},
																"required": ["schema"]
															}
														},
														"required": ["application/json"]
													}
												},
												"required": ["required", "content"]
											},
											"responses": {
												"type": "object",
												"minProperties": 1,
												"maxProperties": 1,
												"propertyNames": {
													"pattern": "^2\\d\\d$"
												},
												"additionalProperties": {
													"type": "object",
													"additionalProperties": false,
													"properties": {
														"description": {
															"type": "string",
															"minLength": 1,
															"maxLength": 1000,
															"pattern": "^[^\\u0000]+$"
														},
														"content": {
															"type": "object",
															"additionalProperties": false,
															"properties": {
																"application/json": {
																	"type": "object",
																	"additionalProperties": false,
																	"properties": {
																		"schema": {
																			"$ref": "#/$defs/apiSchema0"
																		}
																	},
																	"required": ["schema"]
																}
															},
															"required": ["application/json"]
														}
													},
													"required": ["description", "content"]
												}
											}
										},
										"required": ["operationId", "responses"]
									}
								},
								"required": [],
								"minProperties": 1
							}
						}
					},
					"required": ["openapi", "info", "servers", "paths"]
				}
			},
			"required": ["openapi"]
		}
	},
